import Services from "../components/Services.astro";
import Story from "../components/Story.astro";
import CTA from "../components/CTA.astro";
import { footerLinks, navLinks } from "../data/navigation";
---

<Layout
  title="Steel Muse"
  bodyClass="site"
  navHomeHref="/"
  navLinks={navLinks}
  footerLinks={footerLinks}
>
  <Home />
  <WhatWeDo />
  <Garage />
  <Services />
  <Story />
  <CTA />
</Layout>
